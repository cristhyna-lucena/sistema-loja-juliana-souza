{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@sistema/shared#build": { "outputs": ["dist/**"] },
    "@sistema/ui#build": { "outputs": [] },
    "@sistema/db#build": { "outputs": ["dist/**", "src/generated/**"] },
    "@sistema/db#typecheck": { "dependsOn": ["build"] },
    "@sistema/integracoes#build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
