# Campos para a etapa de publicação. Modelo inativo: não substituir o .env local.
# As origens públicas devem ser preenchidas com HTTPS, sem barra final.
NODE_ENV=production
ADMIN_ORIGIN=
LOJA_ORIGIN=

# Topologia preparada: quatro processos no mesmo servidor, atrás de proxy HTTPS.
# Portas locais: loja 3000, painel 3001, API 3002. Worker sem porta pública.
API_PORT=3002
API_INTERNAL_URL=http://127.0.0.1:3002
DATABASE_URL=
REDIS_URL=

# Endpoint HTTPS acessível ao servidor e ao navegador para upload assinado.
# Bucket privado; credenciais preenchidas somente no servidor.
S3_ENDPOINT=
S3_MEDIA_BUCKET=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MEDIA_QUEUE_PREFIX=

# Integrações continuam opcionais e não são ativadas por este modelo.
# Usar configuracao-teste.env.example para os respectivos campos de teste.
