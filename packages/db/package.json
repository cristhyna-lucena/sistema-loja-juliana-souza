    "test": "node --test tests/infrastructure.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "dotenv": "^17.2.3",
    "@types/pg": "^8.15.5"
  }
