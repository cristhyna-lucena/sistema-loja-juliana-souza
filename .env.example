# Referência de variáveis. Execute infra:env para criar .env com senhas aleatórias.
API_PORT=3002
POSTGRES_PORT=5433
REDIS_PORT=6380
POSTGRES_PASSWORD=SUBSTITUIR
REDIS_PASSWORD=SUBSTITUIR
DATABASE_URL=postgresql://sistema_loja:SUBSTITUIR@127.0.0.1:5433/sistema_loja?schema=public
REDIS_URL=redis://:SUBSTITUIR@127.0.0.1:6380
ADMIN_ORIGIN=http://127.0.0.1:3001
API_INTERNAL_URL=http://127.0.0.1:3002
# EMPRESA_ID é necessário quando houver mais de uma empresa ativa.
MINIO_ROOT_USER=GERADO_PELO_MEDIA_ENV
MINIO_ROOT_PASSWORD=GERADO_PELO_MEDIA_ENV
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
S3_ENDPOINT=http://127.0.0.1:19000
S3_MEDIA_BUCKET=sistema-loja-media
MEDIA_QUEUE_PREFIX=sistema-loja-media

# Loja e integrações: mantenha as chaves vazias até configurar as contas.
LOJA_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_URL=
MERCADO_PAGO_AMBIENTE=homologacao
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
ASAAS_AMBIENTE=homologacao
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PAGARME_AMBIENTE=homologacao
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_USER=webhook
PAGARME_WEBHOOK_PASSWORD=
CORREIOS_AMBIENTE=homologacao
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CONTRATO=
CORREIOS_PAC=03298
CORREIOS_SEDEX=03220
FOCUS_TOKEN=
FOCUS_TOKEN_PRODUCAO=
FOCUS_WEBHOOK_TOKEN=
